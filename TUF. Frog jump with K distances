class Solution:
    def frogJump(self, heights, k):
        def rec(n):
            if n==0:
                return 0
            min_steps=float("inf")
            for i in range(1,k+1):
                if n-i>=0:
                    jump=rec(n-i)+abs(heights[n-i]-heights[n])
                    min_steps=min(min_steps,jump)
            return min_steps
        return rec(len(heights)-1)#Recursive approach 


class Solution:
    def frogJump(self, heights, k):
        dp=[-1]*(len(heights)+1)
        def rec(n):
            if n==0:
                return 0
            if dp[n]!=-1:
                return dp[n]
            min_steps=float("inf")
            for i in range(1,k+1):
                if n-i>=0:
                    jump=rec(n-i)+abs(heights[n-i]-heights[n])
                    min_steps=min(min_steps,jump)
            dp[n]=min_steps
            return dp[n]
        return rec(len(heights)-1)#Memorization approach: dynamic programming 



class Solution:
    def frogJump(self, heights, k):
        dp=[-1]*(len(heights)+1)
        dp[0]=0
        for i in range(1,len(heights)):
            min_steps=float("inf")
            for j in range(1,k+1):
                if i-j>=0:
                   jump= dp[i-j]+abs(heights[i-j]-heights[i])
                   min_steps=min(min_steps,jump)
            dp[i]=min_steps

        return dp[len(heights)-1] #tabularization approach dynamic programming 
               
