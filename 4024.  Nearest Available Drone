class Solution:
    def nearestDrone(self, drones: list[list[int]], target: list[int]) -> int:
        ans = -1
        best=float("inf")
        for i,x in enumerate(drones):
            if abs(x[0]-target[0])+abs(x[1]-target[1])<= x[2]:
                if abs(x[0]-target[0])+abs(x[1]-target[1]) <best:
                    ans=i
                    best= abs(x[0]-target[0])+abs(x[1]-target[1])
        return ans
                    
                
