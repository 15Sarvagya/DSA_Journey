class Solution:
    def nthRoot(self, n, m):
       low = 0
       high =m
       while(low<=high):
           mid=(low+high)//2
           product=1
           for i in range(n):
               product *=mid
               if product>m:
                   break
           if product == m:
               return mid
           elif product<m:
               low = mid+1
           else:
               high = mid-1
       return -1
             
               
       
