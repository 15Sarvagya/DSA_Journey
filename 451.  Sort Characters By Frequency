class Solution:
    def frequencySort(self, s: str) -> str:
        hash1={}
        ans=""
        for ch in s:
            hash1[ch] = hash1.get(ch,0)+1
        sorted_hash = dict(sorted(hash1.items(), key=lambda x: x[1], reverse=True))
        for ch in sorted_hash:
           ans+= ch*sorted_hash[ch]
        return ans

