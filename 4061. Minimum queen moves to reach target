class Solution:
    def minQueenMoves(self, source: list[int], target: list[int]) -> int:
        if source == target:
            return 0
        sr,sc = source
        tr,tc= target
        if sr==tr:
            return 1
        if sc==tc:
            return 1
        if abs(sr-tr)==abs(sc-tc):
            return 1
        return 2
