# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def mergeTwoLists(self, list1: Optional[ListNode], list2: Optional[ListNode]) -> Optional[ListNode]:
        ans=[]
        curr1 = list1
        while(curr1!=None):
            ans.append(curr1.val)
            curr1=curr1.next
        curr2=list2
        while(curr2!=None):
            ans.append(curr2.val)
            curr2=curr2.next
        ans.sort()
        dummy = ListNode(0)
        curr = dummy
        for num in ans:
            newNode = ListNode(num)
            curr.next=newNode
            curr=curr.next
        return dummy.next
            
        
