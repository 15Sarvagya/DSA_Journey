class Solution:
    def containsNearbyDuplicate(self, nums: List[int], k: int) -> bool:
        hash={}
        n = len(nums)
        for i in range(n):
            if nums[i] in hash:
                if abs(hash[nums[i]]-i) <=k:
                    return True
            hash[nums[i]] =i
        return False
