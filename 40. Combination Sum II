class Solution:
    def combinationSum2(self, candidates: List[int], target: int) -> List[List[int]]:
        candidates.sort()
        n = len(candidates)
        arr=[]
        ans=[]
        def rec(idx,total):
            if total==target :
                if arr not in ans:
                    ans.append(arr.copy())
                return 
            if idx>=n or total>target:
                return
            for i in range(idx,n):
                if i>idx and candidates[i]==candidates[i-1]:
                    continue
                arr.append(candidates[i])
                rec(i+1,total+candidates[i])
                arr.pop()
        rec(0,0)
        return ans
