class Solution:
    def minimumSumSubarray(self, nums: List[int], l: int, r: int) -> int:
        mini = float("inf")
        for i in range(len(nums)):
            for j in range(i,len(nums)):
                length = j - i + 1
                if l<= length <=r:
                    s = sum(nums[i:j+1])
                    if s>0:
                        mini = min(mini,s)
        if mini == float("inf"):
            return -1
        else:
            return mini
                        
