class Solution:
    def countSpecialIntegers(self, nums: list[int]) -> int:
        count =0
        seen=set()
        not_spec=set()
        prev=None
        for i in nums:
            if i != prev:
                if i in seen:
                    not_spec.add(i)
                else:
                    seen.add(i)
            prev=i
        return len(seen-not_spec)
        
                    
            
            
        
