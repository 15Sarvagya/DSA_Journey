class Solution:
    def countRotations(self, s: str, k: int) -> int:
        n = len(s)
        count=0
        for i in range(n):
            rotation=s[i:]+s[:i]
            score =0
            for j in range(1,n):
                if rotation[j-1]==rotation[j]:
                    score+=1
            if score==k:
                count+=1
        return count
            
