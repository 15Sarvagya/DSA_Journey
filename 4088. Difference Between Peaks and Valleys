class Solution:
    def peakValleyDifference(self, nums: list[int]) -> int:
        Sum1=0
        Sum2=0
        n = len(nums)
        for i in range(1,n-1):
            if nums[i]>nums[i-1] and nums[i]>nums[i+1]:
                Sum1+=nums[i]
            if nums[i]<nums[i-1] and nums[i]<nums[i+1]:
                Sum2+=nums[i]
        return Sum1-Sum2
