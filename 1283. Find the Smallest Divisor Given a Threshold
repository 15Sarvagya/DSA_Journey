class Solution:
    def smallestDivisor(self, nums: List[int], threshold: int) -> int:
        low =1
        high = max(nums)
        ans=float('inf')
        while(low<=high):
            mid = (low+high)//2
            SUM=0
            for num in nums:
                SUM +=(num+mid-1)//mid
            if SUM<=threshold:
                ans = mid
                high = mid-1
            else:
                low = mid+1
        return ans
