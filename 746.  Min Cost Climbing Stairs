class Solution:
    def minCostClimbingStairs(self, cost: list[int]) -> int:
        def rec(n):
            if n<=1:
                return 0
            left = rec(n-1)+cost[n-1]
            if n>1:
                right = rec(n-2)+cost[n-2]
                return min(left,right)
            return left
        return rec(len(cost)) # Recursive technique: we are getting a time limit exceeded (TLE). 


class Solution:
    def minCostClimbingStairs(self, cost: list[int]) -> int:
        n = len(cost)
        dp=[-1]*(n+1)
        def rec(n):
            if n<=1:
                return 0
            if dp[n]!=-1:
                return dp[n]
            left = rec(n-1)+cost[n-1]
            if n>1:
                right = rec(n-2)+cost[n-2]
                dp[n]= min(left,right)
                return dp[n]
            dp[n]= left
            return dp[n]
        return rec(len(cost)) # Memorization technique DP 


class Solution:
    def minCostClimbingStairs(self, cost: list[int]) -> int:
        n = len(cost)
        dp=[-1]*(n+1)
        dp[0]=0
        dp[1]=0
        for i in range(2,n+1):
            left = dp[i-1]+cost[i-1]
            right = dp[i-2]+cost[i-2]
            dp[i]=min(left,right)
        return dp[n] # Tabularization way dynamic programming 


class Solution:
    def minCostClimbingStairs(self, cost: list[int]) -> int:
        n = len(cost)
        prev2=0
        prev=0
        for i in range(2,n+1):
            left = prev+cost[i-1]
            right = prev2+cost[i-2]
            curr=min(left,right)
            prev2=prev
            prev=curr
        return curr space optimization of the tabularization dynamic programming 


