class Solution:
    def minBishopMoves(self, source: list[int], target: list[int]) -> int:
        sr,sc = source
        tr,tc = target
        if source == target:
            return 0
        if (sr+sc)%2 != (tr+tc)%2:
            return -1
        if abs(sr-tr) == abs(sc-tc):
            return 1
        return 2
