# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def getDecimalValue(self, head: Optional[ListNode]) -> int:
        def rec(node,num):
            if node ==None:
                return num
            num = num*2+node.val
            return rec(node.next,num)
        return rec(head,0)
            
