class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        if len(s)!=len(t):
            return False
        hash1={}
        for i in s:
            hash1[i] = hash1.get(i,0)+1
        for i in t:
            if i not in hash1:
               return False
            hash1[i]-=1
            if hash1[i]<0:
                return False
        return True
