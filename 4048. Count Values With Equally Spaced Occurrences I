class Solution:
    def countSpecialIntegers(self, nums: list[int]) -> int:
        hash={}
        count=0
        for num in nums:
            hash[num]= hash.get(num,0)+1
        for i in hash:
            if hash[i]==3:
                index=[]
                for x,num in enumerate(nums):
                    if num==i:
                        index.append(x)
                        
                if index[1]-index[0]==index[2]-index[1]:
                    count+=1
        return count
                        
                        
            
