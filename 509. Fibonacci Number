class Solution:
    def fib(self, n: int) -> int:
        def rec(n):
            if n==1:
                return 1
            if n==0:
                return 0
            return rec(n-1)+rec(n-2)
        return rec(n) # Recursion


class Solution:
    def fib(self, n: int) -> int:
        dp=[-1]*(n+1)
        def rec(n,dp):
            if n<=1:
                return n
            if dp[n]!=-1:
                return dp[n]
            dp[n] = rec(n-1,dp)+rec(n-2,dp)
            return dp[n]
        return rec(n,dp) #Dynamic Programming
            
