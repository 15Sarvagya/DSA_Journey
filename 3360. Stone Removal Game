class Solution:
    def canAliceWin(self, n: int) -> bool:
        if n<10:
            return False
        y=10
        Bob=False
        Alice=False
        count=0
        while(n>=y):
            n-=y
            if count%2==0:
                Alice=True
            else:
                Bob=True
            count+=1
            y-=1
        if count%2==1:
            return True
        else:
            return False
