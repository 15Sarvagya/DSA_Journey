class Solution:
    def exist(self, board: list[list[str]], word: str) -> bool:
        n = len(board)
        m = len(board[0])
        def rec(r,c,idx):
            if idx ==len(word):
                return True
            if r<0 or r>=n or c<0 or c>=m:
                return False
            if board[r][c]!=word[idx]:
                return False
            temp = board[r][c]
            board[r][c]="#"
            if rec(r+1,c,idx+1):
                return True
            if rec(r-1,c,idx+1):
                return True
            if rec(r,c+1,idx+1):
                return True
            if rec(r,c-1,idx+1):
                return True
            board[r][c]=temp
            return False
        for r in range(n):
            for c in range(m):
                if rec(r,c,0):
                    return True
        return False       
