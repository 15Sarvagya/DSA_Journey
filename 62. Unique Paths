class Solution:
    def uniquePaths(self, m: int, n: int) -> int:
        def rec(i,j):
            if i==0 and j==0:
                return 1
            if i<0 or j<0:
                return 0
            up = rec(i-1,j)
            left = rec(i,j-1)
            return up +left
        return rec(m-1,n-1)#Recursive solution giving time limit exceeded (TLE) 


class Solution:
    def uniquePaths(self, m: int, n: int) -> int:
        dp = [[-1]*n for _ in range(m)]
        def rec(i,j):
            if i==0 and j==0:
                return 1
            if i<0 or j<0:
                return 0
            if dp[i][j]!=-1:
                return dp[i][j]
            up = rec(i-1,j)
            left = rec(i,j-1)
            dp[i][j]=up +left
            return dp[i][j]
        return rec(m-1,n-1) #Memoization technique, dynamic programming 



class Solution:
    def uniquePaths(self, m: int, n: int) -> int:
        dp = [[-1]*n for _ in range(m)]
        dp[0][0]=1
        for i in range(m):
            for j in range(n):
                if i==0 and j==0:
                    dp[0][0]=1
                else:
                    up=0
                    left=0
                    if i>0:
                        up = dp[i-1][j]
                    if j>0:
                        left = dp[i][j-1]
                    dp[i][j]=left+up
        return dp[m-1][n-1]# Tabularization technique: dynamic programming 
