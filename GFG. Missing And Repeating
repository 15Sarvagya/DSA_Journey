class Solution:
    def findTwoElement(self, arr):
        ans=[]
        hash={}
        for num in arr:
            hash[num] = hash.get(num,0)+1
        for num,value in hash.items():
            if value >1:
                ans.append(num)
        x = set(arr)
        n = len(arr)
        for i in range(1,n+1):
            if i not in x:
                ans.append(i)
        return ans
