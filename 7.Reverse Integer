class Solution:
    def reverse(self, x: int) -> int:
        sign = -1 if x < 0 else 1
        x = abs(x)
        n = x
        RevN0=0
        while(n):
            last = n%10
            RevN0= RevN0*10+last
            n = n//10
        RevN0 *= sign
        if RevN0 < -2**31 or RevN0 > 2**31 - 1:
            return 0
        return RevN0

        
