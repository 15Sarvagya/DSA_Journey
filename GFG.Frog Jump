class Solution:
    def minCost(self, height: list[int]) -> int:
        # code here
        def rec(n):
            if n==0:
                return 0
            left = rec(n-1)+abs(height[n]-height[n-1])
            if n>1:
                right = rec(n-2)+abs(height[n]-height[n-2])
                return min(left,right)
            return left
        return rec(len(height)-1) #Recursive way to solve frog jump. This gave me a TLE (time limit exceeded). 


class Solution:
    def minCost(self, height: list[int]) -> int:
        # code here
        dp = [-1]*(len(height))
        def rec(n):
            if n==0:
                return 0
            if dp[n]!=-1:
                return dp[n]
            left = rec(n-1)+abs(height[n]-height[n-1])
            if n>1:
                right = rec(n-2)+abs(height[n]-height[n-2])
                dp[n]=min(left,right)
                return dp[n]
            dp[n]=left
            return dp[n]
        return rec(len(height)-1)#Using memoization dynamic programming, it's not giving me TLE. 


class Solution:
    def minCost(self, height: list[int]) -> int:
        # code here
        dp = [-1]*(len(height))
        if len(height)<=1:
            return 0
        dp[0]=0
        dp[1]=dp[0]+abs(height[1]-height[0])
        for i in range(2,len(height)):
            left = dp[i-1]+abs(height[i]-height[i-1])
            right=dp[i-2]+abs(height[i]-height[i-2])
            dp[i]=min(left,right)
        return dp[len(height)-1]#Using tabularization dynamic programming 


class Solution:
    def minCost(self, height: list[int]) -> int:
        # code here
        if len(height)<=1:
            return 0
        prev2=0
        prev=abs(height[1]-height[0])
        for i in range(2,len(height)):
            left = prev+abs(height[i]-height[i-1])
            right=prev2+abs(height[i]-height[i-2])
            curr=min(left,right)
            prev2=prev
            prev=curr
        return prev#Space optimization of the tabularization dynamic programming. Here we can see that when we were doing Fibonacci or climbing stairs, we were taking `current` as a loop. Here, we are taking `i` only as a loop, but taking `current` to store the minimum. That's the difference between climbing stairs and Fibonacci. 
