class Solution:
    def minMoves(self, target: int, maxDoubles: int) -> int:
        def rec(target,maxDoubles):
            if target==1:
                return 0
            if maxDoubles==0:
                return target-1
            if target%2==0:
                return 1+rec(target//2,maxDoubles-1)
            else:
                return 1+rec(target-1,maxDoubles)
        return rec(target,maxDoubles)
