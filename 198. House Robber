class Solution:
    def rob(self, nums: list[int]) -> int:
        def rec(n):
            if n==0:
                return nums[0]
            if n<0:
                return 0
            pick = rec(n-2)+nums[n]
            not_pick = rec(n-1)
            return max(pick,not_pick)
            
        return rec(len(nums)-1) #Recursive Approach gets Time Limit Exceeded (TLE). 


        class Solution:
    def rob(self, nums: list[int]) -> int:
        dp = [-1]*(len(nums)+1)
        def rec(n):
            if n==0:
                return nums[0]
            if n<0:
                return 0
            if dp[n]!=-1:
                return dp[n]
            pick = rec(n-2)+nums[n]
            not_pick = rec(n-1)
            dp[n]= max(pick,not_pick)
            return dp[n]
        return rec(len(nums)-1) #Memorization Approach Dynamic Programming 


        class Solution:
    def rob(self, nums: list[int]) -> int:
        dp = [-1]*(len(nums)+1)
        dp[0]= nums[0]
        for i in range(1,len(nums)):
            if i>1:
                pick = dp[i-2]+nums[i]
            else:
                pick = nums[i]
            not_pick = dp[i-1]
            dp[i]= max(pick,not_pick)
        return dp[len(nums)-1] #tabularization approach dynamic programming 



class Solution:
    def rob(self, nums: list[int]) -> int:
        prev2= 0
        prev= nums[0]
        for i in range(1,len(nums)):
            if i>1:
                pick = prev2+nums[i]
            else:
                pick = nums[i]
            not_pick = prev
            curr= max(pick,not_pick)
            prev2=prev
            prev=curr
        return prev #Space Optimization Of Tabularization 
