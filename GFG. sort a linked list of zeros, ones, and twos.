'''
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None
'''
	
class Solution:
    def segregate(self, head):
        ans =[]
        curr = head
        while(curr!=None):
            ans.append(curr.data)
            curr=curr.next
        ans.sort()
        curr = head
        for num in ans:
            curr.data = num
            curr = curr.next
        return head
