class Solution:
    def rearrangeArray(self, nums: list[int]) -> list[int]:
        ans=[]
        freq={}
        for num in nums:
            freq[num] = freq.get(num,0)+1
        while freq:
            for num in sorted(freq):
                ans.append(num)
                freq[num]-=1
            for num in list(freq):
                if freq[num]==0:
                    del freq[num]
        return ans
